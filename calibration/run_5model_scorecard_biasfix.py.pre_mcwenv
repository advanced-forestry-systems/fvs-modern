# ---------------------------------------------------------------------------
# 5 Standalone Model Systems
# ---------------------------------------------------------------------------
# calib_components controls FvsConfigLoader keyword injection:
#   None   -> no calibration keywords (pure native FVS)
#   "all"  -> full: SDIMAX + BAMAX + MORTMULT + BAIMULT + HTGMULT
#   dict   -> partial: always SDIMAX + BAMAX;
#             "mort": True  -> also MORTMULT (omit when gompit handles mortality)
#             "dg":   True  -> also BAIMULT
#             "hg":   True  -> also HTGMULT
#
# states_restrict_dg: states where Greg DG is applied. For plots outside this
#   list, DG env vars are stripped and calibrated BAIMULT is injected instead.
#   The model continues to run -- only the DG component is swapped per plot.
STANDALONE_MODELS: dict[str, dict] = {
    # System 1: pure native FVS -- no env hooks, no calibration keywords, native varmort
    "fvs_base": {
        "extra_env":          {},
        "calib_components":   None,
        "variant_compatible": None,
        "states_restrict":    None,
        "states_restrict_dg": None,
    },
    # System 2: FVS with calibrated keywords -- BAIMULT + HTGMULT + MORTMULT;
    #           no Greg hooks, no GOMPIT env var (MORTMULT handles mortality)
    "fvs_regional": {
        "extra_env":          {},
        "calib_components":   {"dg": True, "hg": True, "mort": True},
        "variant_compatible": None,
        "states_restrict":    None,
        "states_restrict_dg": None,
    },
    # System 3: Greg DG + Greg HG ORGANON arm + Greg CRW + GOMPIT mortality
    "organon": {
        "extra_env": {
